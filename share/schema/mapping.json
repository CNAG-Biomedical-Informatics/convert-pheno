{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CNAG-Biomedical-Informatics/convert-pheno/schema/mapping-v2.json",
  "title": "Convert-Pheno mapping file v2",
  "description": "Strict source-to-Beacon mapping contract for tabular conversions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappingVersion", "source", "target", "project", "defaults", "records", "beacon"],
  "properties": {
    "mappingVersion": { "const": 2 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["csv", "redcap", "cdisc-odm"] }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "schemaVersion"],
      "properties": {
        "model": { "const": "beacon" },
        "schemaVersion": { "const": "2.0.0" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology"],
      "properties": {
        "ontology": { "$ref": "#/$defs/ontology" }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visitId": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceField"],
          "properties": { "sourceField": { "$ref": "#/$defs/nonEmptyString" } }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "sourceFields"],
          "properties": {
            "strategy": { "const": "firstNonNull" },
            "sourceFields": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    },
    "beacon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["individuals"],
      "properties": {
        "individuals": { "$ref": "#/$defs/individualsMapping" },
        "biosamples": { "$ref": "#/$defs/biosamplesMapping" },
        "datasets": { "$ref": "#/$defs/datasetDefaults" },
        "cohorts": { "$ref": "#/$defs/cohortDefaults" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "ontology": {
      "type": "string",
      "enum": ["ncit", "icd10", "ohdsi", "cdisc", "omim", "hpo"]
    },
    "ontologyTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\w[^:]+:.+$" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "enum": ["field", "value", "fieldNote"] },
        "literal": { "$ref": "#/$defs/nonEmptyString" },
        "aliases": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "oneOf": [
        { "required": ["from"] },
        { "required": ["literal"] }
      ]
    },
    "termTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ontology": { "$ref": "#/$defs/ontology" },
        "query": { "$ref": "#/$defs/query" },
        "term": { "$ref": "#/$defs/ontologyTerm" },
        "terms": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ontologyTerm" }
        }
      },
      "oneOf": [
        { "required": ["query"] },
        { "required": ["term"] }
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
        "notValues": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
        "nonEmpty": { "type": "boolean" }
      }
    },
    "sourceSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" }
      }
    },
    "valueTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "enum": ["sourceValue", "individualId"] },
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "literal": { "type": ["string", "number", "boolean"] }
      },
      "oneOf": [
        { "required": ["from"] },
        { "required": ["sourceField"] },
        { "required": ["literal"] }
      ]
    },
    "idMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields", "primaryKey"],
          "properties": {
            "fields": { "$ref": "#/$defs/stringArray" },
            "primaryKey": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "separator": { "type": "string" },
        "missingValue": { "type": "string" }
      }
    },
    "scalarTermMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelector" },
        "target": { "$ref": "#/$defs/termTarget" }
      }
    },
    "scalarValueMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelector" },
        "target": { "$ref": "#/$defs/valueTarget" }
      }
    },
    "infoMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": { "fields": { "$ref": "#/$defs/stringArray" } }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ageRange": { "$ref": "#/$defs/valueTarget" }
          }
        }
      }
    },
    "diseaseRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelector" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diseaseCode"],
          "properties": {
            "diseaseCode": { "$ref": "#/$defs/termTarget" },
            "ageOfOnset": { "$ref": "#/$defs/valueTarget" },
            "familyHistory": { "$ref": "#/$defs/valueTarget" }
          }
        }
      }
    },
    "exposureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelector" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exposureCode", "unit"],
          "properties": {
            "exposureCode": { "$ref": "#/$defs/termTarget" },
            "ageAtExposure": { "$ref": "#/$defs/valueTarget" },
            "unit": { "$ref": "#/$defs/termTarget" },
            "value": { "$ref": "#/$defs/valueTarget" },
            "date": { "$ref": "#/$defs/valueTarget" },
            "duration": { "$ref": "#/$defs/valueTarget" }
          }
        }
      }
    },
    "procedureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelector" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["procedureCode"],
          "properties": {
            "procedureCode": { "$ref": "#/$defs/termTarget" },
            "ageAtProcedure": { "$ref": "#/$defs/valueTarget" },
            "bodySite": { "$ref": "#/$defs/termTarget" },
            "dateOfProcedure": { "$ref": "#/$defs/valueTarget" }
          }
        }
      }
    },
    "referenceRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "const": "redcapDictionary" },
        "low": { "type": "number" },
        "high": { "type": "number" }
      },
      "oneOf": [
        { "required": ["from"] },
        { "required": ["low", "high"] }
      ]
    },
    "quantityMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "value": { "$ref": "#/$defs/valueTarget" },
        "unit": { "$ref": "#/$defs/termTarget" },
        "referenceRange": { "$ref": "#/$defs/referenceRange" }
      }
    },
    "measureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelector" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assayCode", "measurementValue"],
          "properties": {
            "assayCode": { "$ref": "#/$defs/termTarget" },
            "measurementValue": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quantity"],
              "properties": { "quantity": { "$ref": "#/$defs/quantityMapping" } }
            },
            "procedure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["procedureCode"],
              "properties": { "procedureCode": { "$ref": "#/$defs/termTarget" } }
            }
          }
        }
      }
    },
    "phenotypicFeatureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelector" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["featureType"],
          "properties": { "featureType": { "$ref": "#/$defs/termTarget" } }
        }
      }
    },
    "treatmentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelector" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["treatmentCode"],
          "properties": {
            "treatmentCode": { "$ref": "#/$defs/termTarget" },
            "routeOfAdministration": { "$ref": "#/$defs/termTarget" },
            "ageAtOnset": { "$ref": "#/$defs/valueTarget" },
            "cumulativeDose": { "$ref": "#/$defs/quantityMapping" },
            "doseIntervals": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quantity"],
              "properties": { "quantity": { "$ref": "#/$defs/quantityMapping" } }
            }
          }
        }
      }
    },
    "individualsMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sex"],
      "properties": {
        "id": { "$ref": "#/$defs/idMapping" },
        "sex": { "$ref": "#/$defs/scalarTermMapping" },
        "ethnicity": { "$ref": "#/$defs/scalarTermMapping" },
        "geographicOrigin": { "$ref": "#/$defs/scalarTermMapping" },
        "karyotypicSex": { "$ref": "#/$defs/scalarValueMapping" },
        "info": { "$ref": "#/$defs/infoMapping" },
        "diseases": { "type": "array", "items": { "$ref": "#/$defs/diseaseRule" } },
        "exposures": { "type": "array", "items": { "$ref": "#/$defs/exposureRule" } },
        "interventionsOrProcedures": { "type": "array", "items": { "$ref": "#/$defs/procedureRule" } },
        "measures": { "type": "array", "items": { "$ref": "#/$defs/measureRule" } },
        "phenotypicFeatures": { "type": "array", "items": { "$ref": "#/$defs/phenotypicFeatureRule" } },
        "treatments": { "type": "array", "items": { "$ref": "#/$defs/treatmentRule" } }
      }
    },
    "biosampleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelector" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "biosampleStatus", "sampleOriginType"],
          "properties": {
            "id": { "$ref": "#/$defs/valueTarget" },
            "individualId": { "$ref": "#/$defs/valueTarget" },
            "biosampleStatus": { "$ref": "#/$defs/termTarget" },
            "sampleOriginType": { "$ref": "#/$defs/termTarget" },
            "sampleOriginDetail": { "$ref": "#/$defs/termTarget" },
            "collectionDate": { "$ref": "#/$defs/valueTarget" },
            "notes": { "$ref": "#/$defs/valueTarget" },
            "obtentionProcedure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["procedureCode"],
              "properties": { "procedureCode": { "$ref": "#/$defs/termTarget" } }
            },
            "measurements": { "type": "array", "items": { "$ref": "#/$defs/measureRule" } },
            "info": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceFields"],
              "properties": { "sourceFields": { "$ref": "#/$defs/stringArray" } }
            }
          }
        }
      }
    },
    "biosamplesMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappings"],
      "properties": {
        "mappings": { "type": "array", "items": { "$ref": "#/$defs/biosampleRule" } }
      }
    },
    "datasetDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults"],
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/nonEmptyString" },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "description": { "type": "string" },
            "version": { "type": "string" },
            "externalUrl": { "type": "string" },
            "createDateTime": { "type": "string" },
            "updateDateTime": { "type": "string" },
            "info": { "type": "object" }
          }
        }
      }
    },
    "cohortDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults"],
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/nonEmptyString" },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "cohortType": { "$ref": "#/$defs/nonEmptyString" },
            "cohortSize": { "type": "integer", "minimum": 0 },
            "cohortDataTypes": { "type": "array", "items": { "$ref": "#/$defs/ontologyTerm" } },
            "cohortDesign": { "type": "object" },
            "inclusionCriteria": { "type": "object" },
            "exclusionCriteria": { "type": "object" }
          }
        }
      }
    }
  }
}
