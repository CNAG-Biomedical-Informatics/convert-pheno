{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CNAG-Biomedical-Informatics/convert-pheno/schema/mapping-v2.json",
  "title": "Convert-Pheno mapping file v2",
  "description": "Concise source-to-Beacon contract for tabular authoring, SDTM terminology enrichment, and metadata overlays for built-in conversions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappingVersion", "source", "target", "project"],
  "properties": {
    "mappingVersion": { "const": 2 },
    "source": {
      "type": "object",
      "description": "Normalized record profile consumed by this mapping.",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "description": "Use redcap for REDCap CSV and REDCap-origin ODM; cdisc-odm for standard or vendor ODM with embedded metadata; cbioportal for patient and sample clinical tables; sdtm for Dataset-JSON or Dataset-XML terminology enrichment; or the matching built-in source profile for a metadata-only overlay.",
          "enum": ["cbioportal", "cdisc-odm", "csv", "fhir", "i2b2", "omop", "openehr", "pcornet", "pxf", "redcap", "sdtm", "sentinel"]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "schemaVersion"],
      "properties": {
        "model": { "const": "beacon" },
        "schemaVersion": { "const": "2.0.0" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology"],
      "properties": {
        "ontology": { "$ref": "#/$defs/ontology" }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visitId": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceField"],
          "properties": { "sourceField": { "$ref": "#/$defs/nonEmptyString" } }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "sourceFields"],
          "properties": {
            "strategy": { "const": "firstNonNull" },
            "sourceFields": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    },
    "beacon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "individuals": { "$ref": "#/$defs/individualsMapping" },
        "biosamples": { "$ref": "#/$defs/biosampleCollection" },
        "datasets": { "$ref": "#/$defs/datasetDefaults" },
        "cohorts": { "$ref": "#/$defs/cohortDefaults" }
      }
    },
    "terminology": {
      "type": "object",
      "description": "Ontology resolution rules for term-bearing SDTM fields. Structural SDTM-to-BFF mappings remain built in.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9]{0,7}\\.[A-Z][A-Z0-9_]{0,31}$"
      },
      "additionalProperties": { "$ref": "#/$defs/termTarget" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": { "profile": { "const": "sdtm" } },
            "required": ["profile"]
          }
        }
      },
      "then": {
        "required": ["defaults", "terminology"],
        "properties": {
          "records": false,
          "beacon": false
        }
      },
      "else": {
        "if": {
          "properties": {
            "source": {
              "properties": {
                "profile": {
                  "enum": ["fhir", "i2b2", "omop", "openehr", "pcornet", "pxf", "sentinel"]
                }
              },
              "required": ["profile"]
            }
          }
        },
        "then": {
          "properties": {
            "defaults": false,
            "records": false,
            "terminology": false,
            "beacon": {
              "properties": {
                "individuals": false,
                "biosamples": false
              }
            }
          }
        },
        "else": {
          "required": ["defaults", "records", "beacon"],
          "properties": {
            "terminology": false,
            "beacon": { "required": ["individuals"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "ontology": {
      "type": "string",
      "enum": ["ncit", "icd10", "ohdsi", "cdisc", "omim", "hpo"]
    },
    "ontologyTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\w[^:]+:.+$" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "dynamicQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": { "enum": ["field", "value", "fieldNote"] },
        "aliases": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "query": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "$ref": "#/$defs/dynamicQuery" }
      ]
    },
    "termTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ontology": { "$ref": "#/$defs/ontology" },
        "query": { "$ref": "#/$defs/query" },
        "term": { "$ref": "#/$defs/ontologyTerm" },
        "terms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/ontologyTerm" }
        }
      },
      "oneOf": [
        {
          "required": ["term"],
          "not": {
            "anyOf": [
              { "required": ["query"] },
              { "required": ["terms"] }
            ]
          }
        },
        {
          "required": ["terms"],
          "not": { "required": ["term"] }
        },
        {
          "required": ["query"],
          "not": {
            "anyOf": [
              { "required": ["term"] },
              { "required": ["terms"] }
            ]
          }
        }
      ]
    },
    "nullableTermTarget": {
      "oneOf": [
        { "$ref": "#/$defs/termTarget" },
        { "type": "null" }
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
        "notValues": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
        "nonEmpty": { "type": "boolean" }
      }
    },
    "valueTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "enum": ["sourceValue", "individualId"] },
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "literal": { "type": ["string", "number", "boolean"] }
      },
      "oneOf": [
        { "required": ["from"] },
        { "required": ["sourceField"] },
        { "required": ["literal"] }
      ]
    },
    "nullableValueTarget": {
      "oneOf": [
        { "$ref": "#/$defs/valueTarget" },
        { "type": "null" }
      ]
    },
    "idMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFields", "primaryKey"],
      "properties": {
        "sourceFields": { "$ref": "#/$defs/stringArray" },
        "primaryKey": { "$ref": "#/$defs/nonEmptyString" },
        "separator": { "type": "string" },
        "missingValue": { "type": "string" }
      }
    },
    "scalarTermMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField"],
      "properties": {
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" },
        "ontology": { "$ref": "#/$defs/ontology" },
        "query": { "$ref": "#/$defs/query" },
        "term": { "$ref": "#/$defs/ontologyTerm" },
        "terms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/ontologyTerm" }
        }
      },
      "oneOf": [
        {
          "required": ["term"],
          "not": {
            "anyOf": [
              { "required": ["query"] },
              { "required": ["terms"] }
            ]
          }
        },
        {
          "required": ["terms"],
          "not": { "required": ["term"] }
        },
        {
          "required": ["query"],
          "not": {
            "anyOf": [
              { "required": ["term"] },
              { "required": ["terms"] }
            ]
          }
        }
      ]
    },
    "scalarValueMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField", "value"],
      "properties": {
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" },
        "value": { "$ref": "#/$defs/valueTarget" }
      }
    },
    "infoMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFields"],
      "properties": {
        "sourceFields": { "$ref": "#/$defs/stringArray" },
        "ageRange": { "$ref": "#/$defs/valueTarget" }
      }
    },
    "referenceRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "const": "redcapDictionary" },
        "low": { "type": "number" },
        "high": { "type": "number" }
      },
      "oneOf": [
        { "required": ["from"] },
        { "required": ["low", "high"] }
      ]
    },
    "quantityMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/nullableValueTarget" },
        "unit": { "$ref": "#/$defs/nullableTermTarget" },
        "referenceRange": {
          "oneOf": [
            { "$ref": "#/$defs/referenceRange" },
            { "type": "null" }
          ]
        }
      }
    },
    "measurementValueMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quantity": { "$ref": "#/$defs/quantityMapping" }
      }
    },
    "procedureMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "procedureCode": { "$ref": "#/$defs/nullableTermTarget" }
      }
    },
    "diseaseTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diseaseCode": { "$ref": "#/$defs/nullableTermTarget" },
        "ageOfOnset": { "$ref": "#/$defs/nullableValueTarget" },
        "familyHistory": { "$ref": "#/$defs/nullableValueTarget" }
      }
    },
    "diseaseRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField"],
      "properties": {
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" },
        "diseaseCode": { "$ref": "#/$defs/nullableTermTarget" },
        "ageOfOnset": { "$ref": "#/$defs/nullableValueTarget" },
        "familyHistory": { "$ref": "#/$defs/nullableValueTarget" }
      }
    },
    "diseaseCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "defaults": { "$ref": "#/$defs/diseaseTarget" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/diseaseRule" } }
      }
    },
    "exposureTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposureCode": { "$ref": "#/$defs/nullableTermTarget" },
        "ageAtExposure": { "$ref": "#/$defs/nullableValueTarget" },
        "unit": { "$ref": "#/$defs/nullableTermTarget" },
        "value": { "$ref": "#/$defs/nullableValueTarget" },
        "date": { "$ref": "#/$defs/nullableValueTarget" },
        "duration": { "$ref": "#/$defs/nullableValueTarget" }
      }
    },
    "exposureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField"],
      "properties": {
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" },
        "exposureCode": { "$ref": "#/$defs/nullableTermTarget" },
        "ageAtExposure": { "$ref": "#/$defs/nullableValueTarget" },
        "unit": { "$ref": "#/$defs/nullableTermTarget" },
        "value": { "$ref": "#/$defs/nullableValueTarget" },
        "date": { "$ref": "#/$defs/nullableValueTarget" },
        "duration": { "$ref": "#/$defs/nullableValueTarget" }
      }
    },
    "exposureCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "defaults": { "$ref": "#/$defs/exposureTarget" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exposureRule" } }
      }
    },
    "procedureTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "procedureCode": { "$ref": "#/$defs/nullableTermTarget" },
        "ageAtProcedure": { "$ref": "#/$defs/nullableValueTarget" },
        "bodySite": { "$ref": "#/$defs/nullableTermTarget" },
        "dateOfProcedure": { "$ref": "#/$defs/nullableValueTarget" }
      }
    },
    "procedureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField"],
      "properties": {
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" },
        "procedureCode": { "$ref": "#/$defs/nullableTermTarget" },
        "ageAtProcedure": { "$ref": "#/$defs/nullableValueTarget" },
        "bodySite": { "$ref": "#/$defs/nullableTermTarget" },
        "dateOfProcedure": { "$ref": "#/$defs/nullableValueTarget" }
      }
    },
    "procedureCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "defaults": { "$ref": "#/$defs/procedureTarget" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/procedureRule" } }
      }
    },
    "measureTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assayCode": { "$ref": "#/$defs/nullableTermTarget" },
        "measurementValue": { "$ref": "#/$defs/measurementValueMapping" },
        "procedure": { "$ref": "#/$defs/procedureMapping" }
      }
    },
    "measureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField"],
      "properties": {
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" },
        "assayCode": { "$ref": "#/$defs/nullableTermTarget" },
        "measurementValue": { "$ref": "#/$defs/measurementValueMapping" },
        "procedure": {
          "oneOf": [
            { "$ref": "#/$defs/procedureMapping" },
            { "type": "null" }
          ]
        }
      }
    },
    "measureCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "defaults": { "$ref": "#/$defs/measureTarget" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/measureRule" } }
      }
    },
    "phenotypicFeatureTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "featureType": { "$ref": "#/$defs/nullableTermTarget" }
      }
    },
    "phenotypicFeatureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField"],
      "properties": {
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" },
        "featureType": { "$ref": "#/$defs/nullableTermTarget" }
      }
    },
    "phenotypicFeatureCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "defaults": { "$ref": "#/$defs/phenotypicFeatureTarget" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/phenotypicFeatureRule" } }
      }
    },
    "treatmentTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "treatmentCode": { "$ref": "#/$defs/nullableTermTarget" },
        "routeOfAdministration": { "$ref": "#/$defs/nullableTermTarget" },
        "ageAtOnset": { "$ref": "#/$defs/nullableValueTarget" },
        "cumulativeDose": { "$ref": "#/$defs/quantityMapping" },
        "doseIntervals": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "quantity": { "$ref": "#/$defs/quantityMapping" } }
        }
      }
    },
    "treatmentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField"],
      "properties": {
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" },
        "treatmentCode": { "$ref": "#/$defs/nullableTermTarget" },
        "routeOfAdministration": { "$ref": "#/$defs/nullableTermTarget" },
        "ageAtOnset": { "$ref": "#/$defs/nullableValueTarget" },
        "cumulativeDose": { "$ref": "#/$defs/quantityMapping" },
        "doseIntervals": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "quantity": { "$ref": "#/$defs/quantityMapping" } }
        }
      }
    },
    "treatmentCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "defaults": { "$ref": "#/$defs/treatmentTarget" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/treatmentRule" } }
      }
    },
    "individualsMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sex"],
      "properties": {
        "id": { "$ref": "#/$defs/idMapping" },
        "sex": { "$ref": "#/$defs/scalarTermMapping" },
        "ethnicity": { "$ref": "#/$defs/scalarTermMapping" },
        "geographicOrigin": { "$ref": "#/$defs/scalarTermMapping" },
        "karyotypicSex": { "$ref": "#/$defs/scalarValueMapping" },
        "info": { "$ref": "#/$defs/infoMapping" },
        "diseases": { "$ref": "#/$defs/diseaseCollection" },
        "exposures": { "$ref": "#/$defs/exposureCollection" },
        "interventionsOrProcedures": { "$ref": "#/$defs/procedureCollection" },
        "measures": { "$ref": "#/$defs/measureCollection" },
        "phenotypicFeatures": { "$ref": "#/$defs/phenotypicFeatureCollection" },
        "treatments": { "$ref": "#/$defs/treatmentCollection" }
      }
    },
    "biosampleTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nullableValueTarget" },
        "individualId": { "$ref": "#/$defs/nullableValueTarget" },
        "biosampleStatus": { "$ref": "#/$defs/nullableTermTarget" },
        "sampleOriginType": { "$ref": "#/$defs/nullableTermTarget" },
        "sampleOriginDetail": { "$ref": "#/$defs/nullableTermTarget" },
        "collectionDate": { "$ref": "#/$defs/nullableValueTarget" },
        "notes": { "$ref": "#/$defs/nullableValueTarget" },
        "obtentionProcedure": { "$ref": "#/$defs/procedureMapping" },
        "measurements": { "$ref": "#/$defs/measureCollection" },
        "info": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceFields"],
          "properties": { "sourceFields": { "$ref": "#/$defs/stringArray" } }
        }
      }
    },
    "biosampleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField"],
      "properties": {
        "sourceField": { "$ref": "#/$defs/nonEmptyString" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" },
        "id": { "$ref": "#/$defs/nullableValueTarget" },
        "individualId": { "$ref": "#/$defs/nullableValueTarget" },
        "biosampleStatus": { "$ref": "#/$defs/nullableTermTarget" },
        "sampleOriginType": { "$ref": "#/$defs/nullableTermTarget" },
        "sampleOriginDetail": { "$ref": "#/$defs/nullableTermTarget" },
        "collectionDate": { "$ref": "#/$defs/nullableValueTarget" },
        "notes": { "$ref": "#/$defs/nullableValueTarget" },
        "obtentionProcedure": {
          "oneOf": [
            { "$ref": "#/$defs/procedureMapping" },
            { "type": "null" }
          ]
        },
        "measurements": {
          "oneOf": [
            { "$ref": "#/$defs/measureCollection" },
            { "type": "null" }
          ]
        },
        "info": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceFields"],
              "properties": { "sourceFields": { "$ref": "#/$defs/stringArray" } }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "biosampleCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "defaults": { "$ref": "#/$defs/biosampleTarget" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/biosampleRule" } }
      }
    },
    "datasetDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults"],
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/nonEmptyString" },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "description": { "type": "string" },
            "version": { "type": "string" },
            "externalUrl": { "type": "string" },
            "createDateTime": { "type": "string" },
            "updateDateTime": { "type": "string" },
            "dataUseConditions": { "type": "object" },
            "info": { "type": "object" }
          }
        }
      }
    },
    "cohortDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults"],
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/nonEmptyString" },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "cohortType": { "$ref": "#/$defs/nonEmptyString" },
            "cohortSize": { "type": "integer", "minimum": 0 },
            "cohortDataTypes": { "type": "array", "items": { "$ref": "#/$defs/ontologyTerm" } },
            "cohortDesign": { "type": "object" },
            "collectionEvents": { "type": "array" },
            "inclusionCriteria": { "type": "object" },
            "exclusionCriteria": { "type": "object" }
          }
        }
      }
    }
  }
}
