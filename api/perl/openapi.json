{
  "openapi": "3.0.2",
  "info": {
    "title": "Convert-Pheno API",
    "description": "Convert-Pheno API configuration",
    "version": "0.33"
  },
  "paths": {
    "/api": {
      "post": {
        "x-mojo-name": "post_data",
        "summary": "Get Body",
        "operationId": "get_body_api_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "ConversionRequest",
                "required": [
                  "conversion",
                  "input"
                ],
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "conversion": {
                    "title": "Conversion",
                    "type": "string"
                  },
                  "input": {
                    "title": "Input",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "data": {}
                    }
                  },
                  "output": {
                    "title": "Output",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "entities": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "derived_entity_overrides": {
                        "type": "object"
                      }
                    }
                  },
                  "options": {
                    "title": "Options",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "default_vital_status": {
                        "type": "string",
                        "enum": ["ALIVE", "DECEASED", "UNKNOWN_STATUS"]
                      },
                      "levenshtein_weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "max_lines_sql": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "min_text_similarity_score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "ohdsi_db": {
                        "type": "boolean"
                      },
                      "omop_tables": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "print_hidden_labels": {
                        "type": "boolean"
                      },
                      "search": {
                        "type": "string",
                        "enum": ["exact", "mixed", "fuzzy"]
                      },
                      "source_info": {
                        "type": "boolean"
                      },
                      "test": {
                        "type": "boolean"
                      },
                      "text_similarity_method": {
                        "type": "string",
                        "enum": ["cosine", "dice"]
                      },
                      "username": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {},
                    "meta": {
                      "type": "object",
                      "properties": {
                        "conversion": {
                          "type": "string"
                        }
                      },
                      "required": ["conversion"]
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Request validation or conversion error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [false]
                    },
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "conversion": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
