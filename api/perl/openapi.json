{
  "openapi": "3.0.3",
  "info": {
    "title": "Convert-Pheno Job API",
    "description": "Authenticated local service used by Convert-Pheno Desktop. Upload files or supply JSON, submit a job, poll its status, then preview or download outputs. Requests run asynchronously; a 202 response is not a completed conversion. Native-only endpoints require an additional local token and must not be exposed to remote clients.",
    "version": "0.35"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local Mojolicious development server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Check service health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InfrastructureError"
          }
        }
      }
    },
    "/api/conversions": {
      "get": {
        "summary": "List conversion routes and current availability",
        "operationId": "getConversions",
        "responses": {
          "200": {
            "description": "Registry-driven conversion catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InfrastructureError"
          }
        }
      }
    },
    "/api/inputs": {
      "post": {
        "summary": "Upload files and receive reusable handles",
        "responses": {
          "201": {
            "description": "Upload files and receive reusable handles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FileHandle"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or incorrect bearer token"
          },
          "403": {
            "description": "Host, origin, or native access rejected"
          },
          "422": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "files"
                ],
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Up to 128 files and 100 MiB total per request. Files are retained in the service state directory, not deleted at the end of the request. Map returned handles to input roles when submitting a job."
      }
    },
