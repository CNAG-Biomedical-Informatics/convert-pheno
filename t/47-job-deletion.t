use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use Path::Tiny qw(path);
use JSON::XS qw(encode_json);
use Convert::Pheno::HTTP::Jobs;

my $root = tempdir(CLEANUP => 1);
my $external = path(tempdir(CLEANUP => 1));
my $jobs = Convert::Pheno::HTTP::Jobs->new(root => $root, worker => 'api/perl/worker.pl');
sub fixture {
    my ($digit, $custom, $state) = @_;
    my $id = $digit x 40;
    my $dir = path($root, $id); $dir->mkpath;
    my $out = $custom ? $external->child("convert-pheno-$id") : $dir->child('outputs');
    $out->mkpath;
    $out->child('individuals.json')->spew_raw('[]');
    my $status = {id => $id, created => 1, status => $state || 'completed', directory => "$out", outputDirectory => "$out",
        result => {artifacts => [{filename => 'individuals.json'}]}};
    $dir->child('status.json')->spew_raw(encode_json($status));
    return ($id, $dir, $out, $status);
}
my ($id, $dir, $out) = fixture('a');
$jobs->delete_files($id);
ok(!-e $dir, 'disk deletion removes internal run folder and default outputs');
is(scalar @{$jobs->list}, 0, 'disk deletion also removes history');
($id, $dir, $out) = fixture('b', 1);
$external->child('source.csv')->spew_raw('preserve');
$jobs->delete_files($id);
ok(!-e $out && !-e $dir, 'custom output subfolder and internal state are removed');
is($external->child('source.csv')->slurp_raw, 'preserve', 'custom output parent and unrelated source are retained');
($id, $dir, $out) = fixture('c');
$out->child('my-notes.txt')->spew_raw('preserve');
ok(!eval { $jobs->delete_files($id); 1 }, 'unexpected output files block deletion');
ok(-f $out->child('individuals.json'), 'preflight failure preserves original output');
($id, $dir, $out) = fixture('d', 0, 'running');
ok(!eval { $jobs->delete_files($id); 1 }, 'running jobs cannot be deleted');
ok(-d $out, 'active output folder remains');
my ($other, $otherdir, undef, $status) = fixture('e');
$status->{directory} = "$external"; $status->{outputDirectory} = "$external";
$otherdir->child('status.json')->spew_raw(encode_json($status));
ok(!eval { $jobs->delete_files($other); 1 }, 'arbitrary output parent cannot be deleted');
($id, $dir, $out) = fixture('f');
path($root, 'd' x 40, 'request.json')->spew_raw(encode_json({files => {source => [{path => "@{[$out->child('individuals.json')]}"}]}}));
ok(!eval { $jobs->delete_files($id); 1 }, 'active consumer blocks deletion of its input');
like($@, qr/Another active run/, 'dependency refusal explains why');
ok(-f $out->child('individuals.json'), 'dependent source is intact');
my ($visible) = fixture('1');
my ($hidden, $hiddendir) = fixture('2');
$jobs->delete_history($hidden);
my $bulk = $jobs->delete_all(1);
is_deeply([sort @{$bulk->{deleted}}], [sort($visible,$hidden)], 'bulk disk deletion includes previously hidden runs');
ok(!-e $hiddendir, 'hidden run files are removed');
is_deeply($bulk->{skipped}, ['d' x 40], 'bulk deletion skips active run');
is(scalar @{$bulk->{failed}}, 3, 'bulk deletion reports unsafe folders and dependent inputs');
ok(-f $out->child('individuals.json'), 'bulk deletion preserves active input');
$bulk = $jobs->delete_all(0);
is(scalar @{$bulk->{deleted}}, 3, 'bulk history deletion hides remaining finished runs');
is(scalar @{$jobs->list}, 1, 'active run remains visible');
$jobs->shutdown;
done_testing;
